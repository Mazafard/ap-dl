export global Theme {
    // Primary & Accent Colors
    out property <color> primary: #f43f5e;
    out property <color> primary_hover: #fb7185;
    out property <color> primary_pressed: #e11d48;
    out property <color> primary_border: #ffffff44;

    // Status Colors
    out property <color> success: #10b981;
    out property <color> warning: #f59e0b;
    out property <color> danger: #ef4444;
    out property <color> danger_hover: #dc2626;
    out property <color> danger_pressed: #991b1b;
    out property <color> cyan_accent: #38bdf8;
    out property <color> cyan_badge_bg: #38bdf814;
    out property <color> cyan_badge_border: #38bdf833;

    // High-Legibility Solid Frosted Glass Backgrounds & Borders
    out property <color> shell_bg: #0E121CF8;
    out property <color> shell_border: #ffffff24;
    out property <color> card_bg: #ffffff12;
    out property <color> card_border: #ffffff1a;
    out property <color> card_item_bg: #ffffff0d;
    out property <color> card_item_border: #ffffff14;
    
    out property <color> btn_bg: #ffffff10;
    out property <color> btn_hover: #ffffff1e;
    out property <color> btn_pressed: #ffffff2a;
    out property <color> btn_border: #ffffff1a;
    
    out property <color> modal_backdrop: #000000bf;
    out property <color> modal_bg: #141720F8;
    out property <color> modal_border: #ffffff2a;

    // Text & Foreground Colors
    out property <color> text_primary: #ffffff;
    out property <color> text_secondary: #e2e8f0;
    out property <color> text_muted: #94a3b8;
    out property <color> text_subtle: #64748b;

    // Radius & Metrics
