    out property <color> danger_pressed: #991b1b;
    out property <color> cyan_accent: #38bdf8;
    out property <color> cyan_badge_bg: #38bdf814;
    out property <color> cyan_badge_border: #38bdf833;

    // Glass Backgrounds & Borders
    out property <color> shell_bg: #0b0f19c0;
    out property <color> shell_border: #ffffff20;
