import { Theme } from "../theme.slint";
import { MediaItem } from "../models.slint";
import { GlassCard } from "../components/glass_card.slint";
import { GlassScrollView } from "../components/glass_scroll_view.slint";
import { QueueToolbar } from "queue/queue_toolbar.slint";
import { QueueEmptyState } from "queue/queue_empty_state.slint";
import { QueueItemRow } from "queue/queue_item_row.slint";
import { QueueFooter } from "queue/queue_footer.slint";

export component QueueView inherits VerticalLayout {
    in-out property <[MediaItem]> media_items: [];
    in-out property <string> total_speed: "Ready";
    in-out property <bool> is_downloading: false;

    callback open_add_modal();
    callback toggle_select_all(bool);
    callback toggle_item(int);
    callback start_download();
    callback cancel_download();

    horizontal-stretch: 1;
    spacing: 12px;

    QueueToolbar {
        item_count: root.media_items.length;
        open_add_modal => { root.open_add_modal(); }
        select_all => { root.toggle_select_all(true); }
        deselect_all => { root.toggle_select_all(false); }
    }

    GlassCard {
        vertical-stretch: 1;

        if root.media_items.length == 0 : QueueEmptyState {}

        if root.media_items.length > 0 : GlassScrollView {
            VerticalLayout {
                spacing: 6px;
                padding: 10px;

                for item[idx] in root.media_items: QueueItemRow {
                    item: item;
                    toggle => { root.toggle_item(idx); }
                }
            }
        }
    }

    QueueFooter {
        is_downloading: root.is_downloading;
        total_speed: root.total_speed;
        has_items: root.media_items.length > 0;
        start_download => { root.start_download(); }
        cancel_download => { root.cancel_download(); }
    }
}
