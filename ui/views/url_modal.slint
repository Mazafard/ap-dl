import { Theme } from "../theme.slint";
import { DarkGlassTextInput } from "../components/dark_text_input.slint";
import { ModalHeader } from "modal/modal_header.slint";
import { ModalActions } from "modal/modal_actions.slint";

export component UrlModalDialog inherits Rectangle {
    in-out property <string> modal_url_input <=> input_field.text;
    in-out property <string> validation_message: "";
    in-out property <bool> is_analyzing: false;

    callback close_modal();
    callback paste_from_clipboard();
    callback submit_url(string);

    width: 100%;
    height: 100%;
    background: Theme.modal_backdrop;

    TouchArea {
        clicked => {
            if (!root.is_analyzing) { root.close_modal(); }
        }
    }

    Rectangle {
        width: 560px;
        min-height: 250px;
        background: Theme.modal_bg;
        border-radius: Theme.radius_xl;
        border-width: 1px;
        border-color: Theme.modal_border;

        TouchArea {}

        VerticalLayout {
            padding: 22px;
            spacing: 16px;

            ModalHeader {
                is_analyzing: root.is_analyzing;
                close_modal => { root.close_modal(); }
            }

            input_field := DarkGlassTextInput {
                horizontal-stretch: 1;
                placeholder: "https://www.aparat.com/v/... or playlist/...";
                enabled: !root.is_analyzing;
                paste_clicked => { root.paste_from_clipboard(); }
                accepted => { root.submit_url(input_field.text); }
            }

            if root.validation_message != "": Rectangle {
                background: #ef444416;
                border-radius: 6px;
                border-width: 1px;
                border-color: #ef444433;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 6px;
                    alignment: start;

                    Text { text: "⚠"; color: #f87171; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                    Text { text: root.validation_message; color: #f87171; font-size: 11px; font-weight: 600; vertical-alignment: center; wrap: char-wrap; }
                }
            }

            Rectangle { vertical-stretch: 1; }

            ModalActions {
                is_analyzing: root.is_analyzing;
                has_input: input_field.text != "";
                cancel => { root.close_modal(); }
                submit => { root.submit_url(input_field.text); }
            }
        }
    }
}
