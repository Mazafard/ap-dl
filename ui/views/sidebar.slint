import { Theme } from "../theme.slint";
import { GlassCard } from "../components/glass_card.slint";
import { GlassButton } from "../components/glass_button.slint";
import { SidebarBrand } from "sidebar/sidebar_brand.slint";
import { SidebarCollectionCard } from "sidebar/sidebar_collection_card.slint";
import { SidebarDestinationCard } from "sidebar/sidebar_destination_card.slint";

export component SidebarView inherits VerticalLayout {
    in-out property <string> collection_title: "No media loaded";
    in-out property <string> collection_details: "Click '+ Add Stream / Playlist' to begin";
    in-out property <string> destination_path: "~/Downloads";
    in-out property <string> app_version: "v0.1.2";
    
    callback open_add_modal();
    callback browse_path();

    width: 280px;
    spacing: 14px;

    // Traffic Lights Clearance (macOS Window Controls)
    Rectangle { height: 16px; }

    SidebarBrand {
        app_version: root.app_version;
    }

    GlassCard {
        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            Text {
                text: "CONTENT INGESTION";
                font-size: 10px;
                font-weight: 700;
                color: Theme.text_muted;
            }

            GlassButton {
                text: "+ Add Stream / Playlist";
                primary: true;
                height: 38px;
                clicked => { root.open_add_modal(); }
            }
        }
    }

    SidebarCollectionCard {
        collection_title: root.collection_title;
        collection_details: root.collection_details;
    }

    SidebarDestinationCard {
        destination_path: root.destination_path;
        browse_path => { root.browse_path(); }
    }
}
