import { Theme } from "../../theme.slint";
import { GlassButton } from "../glass_button.slint";

export component UpdateActions inherits HorizontalLayout {
    in property <bool> is_installing: false;
    callback install_clicked();
    callback browser_clicked();
    callback dismiss_clicked();

    spacing: 8px;
    alignment: end;

    if !root.is_installing : GlassButton {
        text: "Later";
        primary: false;
        clicked => { root.dismiss_clicked(); }
    }

    if !root.is_installing : GlassButton {
        text: "GitHub ↗";
        primary: false;
        clicked => { root.browser_clicked(); }
    }

    if !root.is_installing : GlassButton {
        text: "Install Update";
        primary: true;
        clicked => { root.install_clicked(); }
    }
}
