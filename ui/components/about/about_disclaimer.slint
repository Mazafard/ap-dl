import { Theme } from "../../theme.slint";

export component AboutDisclaimer inherits Rectangle {
    height: 60px;
    border-radius: 8px;
    background: #000000.transparentize(65%);
    border-width: 1px;
    border-color: #FFFFFF.transparentize(92%);

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        alignment: center;

        Text {
            text: "Disclaimer: APDL is an open-source utility designed for downloading publicly available video streams. Please respect creator copyrights and platform terms of service.";
            font-size: 10px;
            color: Theme.text_subtle;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
