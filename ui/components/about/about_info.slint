import { Theme } from "../../theme.slint";
import { AppInfo } from "../../models.slint";

export component AboutInfo inherits VerticalLayout {
    in property <string> app_version: "v" + AppInfo.version;

    alignment: center;
    spacing: 8px;

    HorizontalLayout {
        alignment: center;

        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            background: @linear-gradient(135deg, Theme.primary.transparentize(60%), Theme.cyan_accent.transparentize(70%));
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.primary.transparentize(50%);

            Image {
                source: @image-url("../../../assets/icon.png");
                width: 60px;
                height: 60px;
                x: 2px;
                y: 2px;
            }
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 3px;

        HorizontalLayout {
            alignment: center;
            spacing: 6px;

            Text {
                text: "APDL — Aparat Downloader";
                font-size: 15px;
                font-weight: 800;
                color: Theme.text_primary;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 14px;
                border-radius: 4px;
                background: #f43f5e1a;
                border-width: 1px;
                border-color: #f43f5e44;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    alignment: center;

                    Text {
                        text: root.app_version;
                        font-size: 9px;
                        font-weight: 700;
                        color: #f43f5e;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: "Designed & Developed by " + AppInfo.author;
            font-size: 11px;
            font-weight: 600;
            color: Theme.cyan_accent;
            horizontal-alignment: center;
        }

        Text {
            text: "Fast, Resumable & Multi-Segment Video Stream Engine";
            font-size: 10px;
            color: Theme.text_muted;
            horizontal-alignment: center;
        }
    }
}
