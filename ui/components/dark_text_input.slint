import { Theme } from "../theme.slint";
import { MinimalPasteIcon } from "icons/paste_icon.slint";
import { CloseIcon } from "icons/close_icon.slint";

export component DarkGlassTextInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in-out property <string> placeholder: "";
    in-out property <bool> enabled: true;
    callback accepted();
    callback paste_clicked();

    private property <bool> is_expanded: root.text != "" && root.text.character-count > 46;

    horizontal-stretch: 1;
    min-width: 200px;
    height: is_expanded ? 76px : 42px;
    background: input.has-focus ? #ffffff14 : #ffffff08;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: input.has-focus ? #f43f5ecc : #ffffff18;

    animate height, background, border-color {
        duration: 150ms;
        easing: ease-in-out;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: root.is_expanded ? 10px : 0px;
        padding-bottom: root.is_expanded ? 10px : 0px;
        spacing: 8px;

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            flick := Flickable {
                width: 100%; height: 100%;

                if input.text == "" : Text {
                    text: root.placeholder;
                    color: Theme.text_subtle;
                    font-size: 12px;
                    vertical-alignment: center;
                    y: (parent.height - self.height) / 2;
                }

                input := TextInput {
                    width: flick.width - 4px;
                    color: Theme.text_primary;
                    selection-background-color: #f43f5e88;
                    selection-foreground-color: #ffffff;
                    font-size: 12px;
                    vertical-alignment: center;
                    wrap: root.is_expanded ? char-wrap : no-wrap;
                    single-line: !root.is_expanded;
                    enabled: root.enabled;
                    accepted => { root.accepted(); }
                }
            }
        }

        VerticalLayout {
            alignment: center;

            if root.text != "" : Rectangle {
                width: 24px; height: 24px;
                border-radius: 12px;
                background: clear_touch.has-hover ? #ffffff22 : #ffffff0e;
                clear_touch := TouchArea { mouse-cursor: pointer; clicked => { root.text = ""; } }
                CloseIcon {
                    icon_size: 9px;
                    icon_color: clear_touch.has-hover ? #ffffff : #ffffffa0;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            if root.text == "" : Rectangle {
                width: 28px; height: 28px;
                border-radius: 6px;
                background: paste_touch.pressed ? #ffffff25 : paste_touch.has-hover ? #ffffff18 : #ffffff0a;
                paste_touch := TouchArea { mouse-cursor: pointer; clicked => { root.paste_clicked(); } }
                MinimalPasteIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }
    }
}
